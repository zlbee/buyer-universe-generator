# Buyer Universe Generator local defaults
BUG_APP_NAME="Buyer Universe Generator"
BUG_ENVIRONMENT="local"
BUG_DEBUG=false
BUG_DATABASE_URL="sqlite:///./data/buyer_universe.db"
BUG_CACHE_DIR="./data/cache"
BUG_SEC_USER_AGENT="buyer-universe-generator/0.1 contact@example.com"
BUG_ENABLE_SEC_EDGAR=true
BUG_ENABLE_COMPANY_PAGES=true
BUG_ENABLE_NEWS_API=false
BUG_ENABLE_WIKIDATA=true
BUG_ENABLE_OPEN_WEB_DISCOVERY=false
BUG_MAX_STRATEGIC_CANDIDATES=150
BUG_MAX_FINANCIAL_CANDIDATES=100
BUG_REQUEST_TIMEOUT_SECONDS=30
BUG_CACHE_TTL_HOURS=24
BUG_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
